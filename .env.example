# ---------------------------------------------------------------------------
# Waterline agent — environment configuration (PLACEHOLDERS ONLY)
# Copy to `.env` and fill in. NEVER commit a real private key.
# ---------------------------------------------------------------------------

# --- Service ---
PORT=8080
HOST=0.0.0.0
# Public HTTPS base URL once deployed (used in the agent card). Leave unset
# locally. On Render this is auto-derived from RENDER_EXTERNAL_URL, so you only
# set it to override (e.g. a custom domain).
PUBLIC_URL=
LOG_LEVEL=info
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
RPC_TIMEOUT_MS=8000
# Set to `true` only when running behind a trusted reverse proxy / platform
# router (Fly, Render, Railway, Cloud Run, nginx, a load balancer, ...) so the
# per-IP rate limiter reads the real client IP from X-Forwarded-For. Leave
# `false` when the instance is exposed directly.
TRUST_PROXY=false

# --- Analysis chain: BNB Smart Chain mainnet (56) — where Venus positions live ---
ANALYSIS_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Venus Core-pool Comptroller (Unitroller). VERIFY against https://docs.venus.io
# and BscScan before trusting any on-chain output. Leave empty to disable the
# account-address read path (the explicit-position preview still works).
VENUS_COMPTROLLER_ADDRESS=
# Reject oracle prices older than this many seconds (freshness guard).
PRICE_MAX_STALENESS_SEC=1800

# --- Agent identity (ERC-8004 wallet on BNB Smart Chain Testnet, chain 97) ---
IDENTITY_CHAIN_ID=97
# Public address of the agent's registered wallet (shown in the card).
AGENT_ADDRESS=
# Private key of that wallet, used ONLY to sign EIP-712 price quotes off-chain.
# Never printed, logged, or stored. Replace with your real key in .env (not here).
AGENT_PRIVATE_KEY=

# --- Payment / escrow (BNB Smart Chain Testnet, chain 97) ---
# Escrow settlement token address on chain 97. Provided by Pokter — DO NOT GUESS.
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_DECIMALS=18
PAYMENT_TOKEN_SYMBOL=
# Price per job, expressed in whole payment-token units (e.g. 1 = 1 token).
QUOTE_PRICE=1
# EIP-712 signing domain — the verifying contract (Pokter escrow/job contract on
# chain 97). Taken from the reference agent card / Pokter spec. DO NOT GUESS.
QUOTE_VERIFYING_CONTRACT=
# Quote time-to-live in seconds (short-lived by design).
QUOTE_TTL_SECONDS=300
